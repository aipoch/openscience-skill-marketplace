{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aipoch.github.io/openscience-skill-marketplace/authoring/submission-index.schema.json",
  "title": "Provider-qualified Skill submission index",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "selection_input",
    "summary",
    "providers",
    "submissions"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "selection_input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["archive_name", "archive_sha256"],
      "properties": {
        "archive_name": { "type": "string", "minLength": 1, "maxLength": 500 },
        "archive_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_count",
        "provider_count",
        "unique_skill_ids",
        "pending_review",
        "blocked",
        "runtime_id_collisions",
        "missing_skill_licenses",
        "license_policy_reviews"
      ],
      "properties": {
        "record_count": { "type": "integer", "minimum": 1 },
        "provider_count": { "type": "integer", "minimum": 1 },
        "unique_skill_ids": { "type": "integer", "minimum": 1 },
        "pending_review": { "type": "integer", "minimum": 0 },
        "blocked": { "type": "integer", "minimum": 0 },
        "runtime_id_collisions": { "type": "integer", "minimum": 0 },
        "missing_skill_licenses": { "type": "integer", "minimum": 0 },
        "license_policy_reviews": { "type": "integer", "minimum": 0 }
      }
    },
    "providers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "url",
          "repository",
          "commit",
          "record_count"
        ],
        "properties": {
          "id": { "$ref": "../protocol/common.schema.json#/$defs/id" },
          "name": { "type": "string", "minLength": 1, "maxLength": 200 },
          "url": { "type": "string", "format": "https-url" },
          "repository": { "type": "string", "format": "https-url" },
          "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
          "record_count": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "submissions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "submission_key",
          "skill_id",
          "provider_id",
          "release_config",
          "state",
          "blockers",
          "publication_constraints",
          "review_flags"
        ],
        "properties": {
          "submission_key": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*/[a-z0-9]+(?:-[a-z0-9]+)*@(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
          },
          "skill_id": { "$ref": "../protocol/common.schema.json#/$defs/id" },
          "provider_id": { "$ref": "../protocol/common.schema.json#/$defs/id" },
          "release_config": { "type": "string", "format": "safe-path" },
          "state": { "enum": ["pending-review", "blocked"] },
          "blockers": {
            "type": "array",
            "uniqueItems": true,
            "items": { "enum": ["missing-skill-license"] }
          },
          "publication_constraints": {
            "type": "array",
            "uniqueItems": true,
            "items": { "enum": ["runtime-id-collision"] }
          },
          "review_flags": {
            "type": "array",
            "uniqueItems": true,
            "items": { "enum": ["license-policy-exception"] }
          }
        }
      }
    }
  }
}
