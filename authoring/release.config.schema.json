{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aipoch.github.io/openscience-skill-marketplace/authoring/release.config.schema.json",
  "title": "Skill provider release configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "category",
    "source",
    "licenseFiles"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "$ref": "../protocol/common.schema.json#/$defs/id" },
    "version": {
      "$ref": "../protocol/common.schema.json#/$defs/skill/properties/version"
    },
    "category": {
      "$ref": "../protocol/common.schema.json#/$defs/skill/properties/category"
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "\\S"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "path"],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
          "maxLength": 4096
        },
        "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "path": { "type": "string", "format": "safe-path" }
      }
    },
    "licenseFiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true,
      "items": { "type": "string", "format": "safe-path" }
    }
  }
}
