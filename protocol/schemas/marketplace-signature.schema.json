{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aipoch.github.io/openscience-skill-marketplace/protocol/marketplace-signature.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "algorithm": {
      "const": "ed25519"
    },
    "key_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^openscience-skills-[a-z0-9-]+$"
    },
    "public_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[A-Za-z0-9+/]+={0,2}$"
    },
    "signature": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[A-Za-z0-9+/]+={0,2}$"
    }
  },
  "required": [
    "schema_version",
    "algorithm",
    "key_id",
    "public_key",
    "signature"
  ]
}
