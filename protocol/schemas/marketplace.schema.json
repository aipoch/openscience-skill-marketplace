{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aipoch.github.io/openscience-skill-marketplace/protocol/marketplace.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "protocol": {
      "const": "openscience-skill-marketplace"
    },
    "revision": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "marketplace": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": ["id", "name"]
    },
    "skills": {
      "type": "array",
      "items": {
        "$ref": "https://aipoch.github.io/openscience-skill-marketplace/protocol/common.schema.json#/$defs/listing"
      },
      "maxItems": 584
    },
    "release_index": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^indexes/[a-f0-9]{64}\\.json$"
        },
        "sha256": {
          "$ref": "https://aipoch.github.io/openscience-skill-marketplace/protocol/common.schema.json#/$defs/sha256"
        }
      }
    },
    "previous_revision": {
      "anyOf": [
        {
          "$ref": "https://aipoch.github.io/openscience-skill-marketplace/protocol/common.schema.json#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "protocol",
    "revision",
    "marketplace",
    "skills",
    "release_index",
    "previous_revision"
  ]
}
